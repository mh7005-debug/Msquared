# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Added automatically when you connect a Neon database in Vercel (Storage tab).
DATABASE_URL=

# Team password for downloading CSVs and deleting sessions. Use 12+ characters.
EXPORT_PASSWORD=

# Optional. Lets testers type chat answers. Without it, the chat is tap-only.
ANTHROPIC_API_KEY=
# Optional override. Default: claude-haiku-5-5
ANTHROPIC_MODEL=

# Set to "true" ONLY after a qualified clinician has actually signed off in CONTENT_REVIEW.md.
# Until then the "DEMO — NOT CLINICALLY REVIEWED" banner stays on.
CLINICAL_REVIEW_COMPLETE=false
